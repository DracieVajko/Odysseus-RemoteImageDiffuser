# Copy to /etc/diffusion-server.env and adjust. Referenced by
# systemd/diffusion-server.service.
DIFFUSION_PORT=8101
DIFFUSION_HOST=0.0.0.0
DIFFUSION_MODELS_JSON=/opt/diffusion-server/models.json
HF_HOME=/opt/diffusion-server/.hf_cache
HF_HUB_CACHE=/opt/diffusion-server/.hf_cache/hub
HUGGINGFACE_HUB_CACHE=/opt/diffusion-server/.hf_cache/hub
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_VERBOSITY=warning
TRANSFORMERS_VERBOSITY=warning
PYTHONUTF8=1
PYTHONUNBUFFERED=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
